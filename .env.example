# Conexión a Odoo — INSTANCIA DE PRUEBAS (is_neutralized = true)
ODOO_URL=
ODOO_DB=
ODOO_USER=
# Use un USUARIO DE SERVICIO con los permisos minimos y una CLAVE API (Odoo: Preferencias >
# Seguridad de la cuenta > Claves API), nunca la contrasena de admin. La clave API se pone aqui
# tal cual en lugar de la contrasena.
ODOO_PASSWORD=
# Segundos de espera por respuesta de Odoo antes de reintentar (por defecto 60)
ODOO_TIMEOUT_SEGUNDOS=

# Para probar SIN Odoo: apunta a un archivo { modelo: [registros] } y no se toca la red.
# ODOO_SIMULADO=test/simulado/instancia.json

# Destinatario del reporte diario
REPORTE_PARA=
REPORTE_DE=

# SMTP — vacío = no se envia correo, solo se guarda el reporte en ./reportes
# Para Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 y una "contraseña de aplicacion"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Umbrales de alerta
ALERTA_HORAS_SIN_INGESTA=
ALERTA_PCT_MINIMO=
# Contra que se miden las horas sin ingesta: vacio = contra ahora; 'ultimo-correo' = contra el
# correo mas reciente de la instancia (util en la copia de pruebas, que esta congelada).
ALERTA_REFERENCIA=

# Candado de escritura. 'si' habilita al agente CUENTAS a modificar Odoo (y ademas hay que pasar --aplicar).
PERMITIR_ESCRITURA=
# Catalogo de cuentas distinto al de data/catalogo-cuentas.json (ruta relativa al proyecto)
CATALOGO_CUENTAS=

# ---- El servicio (npm run servicio) ----
# Puerto de la app web y la API (4180)
PUERTO=
# Ruta de la base de datos (data/oficina.db)
BASE_DE_DATOS=
# Si se define, toda acción (POST) exige  Authorization: Bearer <token>
SERVICIO_TOKEN=
# Hora local (HH:MM) a la que corren Recepción y Comunicación cada día; vacío = no corre solo
CORRIDA_DIARIA=
# Día de la semana (0 domingo ... 6 sábado) para Conciliación; vacío = no corre sola
CONCILIACION_SEMANAL=

# ---- El Director por modelo de lenguaje (pestaña Director) ----
# Clave de la API de Claude (console.anthropic.com). Sin ella, el Director es el de palabras clave.
CLAUDE_API_KEY=
# Modelo (vea los ids vigentes en docs.claude.com/en/docs/about-claude/models). Por defecto claude-sonnet-4-5
DIRECTOR_MODELO=
# Máximo de herramientas por pregunta (8)
DIRECTOR_MAX_PASOS=
