# Conexión a Odoo — INSTANCIA DE PRUEBAS (is_neutralized = true)
ODOO_URL=
ODOO_DB=
ODOO_USER=
# Use un USUARIO DE SERVICIO con los permisos minimos y una CLAVE API (Odoo: Preferencias >
# Seguridad de la cuenta > Claves API), nunca la contrasena de admin. La clave API se pone aqui
# tal cual en lugar de la contrasena.
ODOO_PASSWORD=
# Segundos de espera por respuesta de Odoo antes de reintentar (por defecto 60)
ODOO_TIMEOUT_SEGUNDOS=

# Para probar SIN Odoo: apunta a un archivo { modelo: [registros] } y no se toca la red.
# ODOO_SIMULADO=test/simulado/instancia.json

# Destinatario del reporte diario
REPORTE_PARA=
REPORTE_DE=

# SMTP — vacío = no se envia correo, solo se guarda el reporte en ./reportes
# Para Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 y una "contraseña de aplicacion"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Cambio de dominio de los receptores del buzón: viejo=nuevo (varios separados por coma).
# Así rv@viejo.com e rv@nuevo.com son un solo receptor y no reciben dos cartas.
RECEPTORES_DOMINIOS=

# Umbrales de alerta
ALERTA_HORAS_SIN_INGESTA=
ALERTA_PCT_MINIMO=
# Contra que se miden las horas sin ingesta: vacio = contra ahora; 'ultimo-correo' = contra el
# correo mas reciente de la instancia (util en la copia de pruebas, que esta congelada).
ALERTA_REFERENCIA=

# Candado de escritura. 'si' habilita al agente CUENTAS a modificar Odoo (y ademas hay que pasar --aplicar).
PERMITIR_ESCRITURA=
# Catalogo de cuentas distinto al de data/catalogo-cuentas.json (ruta relativa al proyecto)
CATALOGO_CUENTAS=

# ---- El servicio (npm run servicio) ----
# Puerto de la app web y la API (4180)
PUERTO=
# Ruta de la base de datos (data/oficina.db)
BASE_DE_DATOS=
# Si se define, toda acción (POST) exige  Authorization: Bearer <token>
SERVICIO_TOKEN=
# Dónde escucha el servicio: vacío = solo esta PC (127.0.0.1; el túnel de Cloudflare funciona igual).
# En Docker, Fly o Render: 0.0.0.0. Sin SERVICIO_TOKEN, toda conexión remota se rechaza.
SERVICIO_HOST=
# Desde afuera, crear asientos, cambiar el plan de cuentas, aplicar propuestas o enviar correos pide
# sesión personal (enlace de acceso de un usuario contable). "si" lo permite solo con el token: no recomendado.
ESCRITURA_SIN_SESION=
# Hora local (HH:MM) a la que corren Recepción y Comunicación cada día; vacío = no corre solo
CORRIDA_DIARIA=
# Día de la semana (0 domingo ... 6 sábado) para Conciliación; vacío = no corre sola
CONCILIACION_SEMANAL=

# ---- El Director por modelo de lenguaje (pestaña Director) ----
# Clave de la API de Claude (console.anthropic.com). Sin ella, el Director es el de palabras clave.
CLAUDE_API_KEY=
# Solo si la clave es de usuario (sk-ant-usr-…): el id del workspace (console.anthropic.com > Settings > Workspaces)
CLAUDE_WORKSPACE_ID=
# Modelo (vea los ids vigentes en docs.claude.com/en/docs/about-claude/models). Por defecto claude-sonnet-4-5
DIRECTOR_MODELO=
# Máximo de herramientas por pregunta (12). Al agotarse, responde con lo que consultó y dice qué faltó
DIRECTOR_MAX_PASOS=
# Memoria del Director: días que se guardan las conversaciones (30). Cada persona sigue su conversación
# abierta al volver (app y oficina 2D comparten la misma) y el Director ve un resumen de las anteriores.
DIRECTOR_RETENCION_DIAS=
# Turnos recientes que van completos al modelo (6); los anteriores van como pregunta/respuesta. Tope en caracteres (160000)
DIRECTOR_TURNOS_COMPLETOS=
DIRECTOR_MAX_CONTEXTO=

# ---- Varios inquilinos (opcional) ----
# Sin esto, hay un solo inquilino que usa las variables de arriba. Con esto, cada inquilino tiene
# su Odoo, su base, su calendario y su marca; se entra por /t/<id>/ o por su dominio.
# INQUILINOS=iasima,sima
# IASIMA_NOMBRE=IASIMA
# IASIMA_COLOR=#0B4A3F
# IASIMA_LOGO=https://…/logo.png
# IASIMA_DOMINIO=iasima.oficina.cr
# IASIMA_ODOO_URL=https://iasima.tecnodem.net
# IASIMA_ODOO_DB=iasima
# IASIMA_ODOO_USER=oficina@iasima.cr
# IASIMA_ODOO_PASSWORD=
# SIMA_NOMBRE=SIMA
# SIMA_ODOO_URL=
# SIMA_ODOO_DB=
# SIMA_ODOO_USER=
# SIMA_ODOO_PASSWORD=
# (cualquier <ID>_VARIABLE pisa la variable global para ese inquilino: SMTP_*, ALERTA_*, CORRIDA_DIARIA, PERMITIR_ESCRITURA…)

# ---- Fase 3A: Recurrentes ----
# Meses hacia atrás (6), en cuántos tiene que aparecer el proveedor (5), % de desvío del monto (50), mes a evaluar (AAAA-MM; vacío = último mes cerrado)
RECURRENTES_VENTANA=
RECURRENTES_MINIMO=
RECURRENTES_DESVIO=
RECURRENTES_MES=

# ---- Fase 3A: Cierre y Estados financieros ----
# Mes a revisar (AAAA-MM; vacío = último mes cerrado), meses de historia (6), tolerancia en colones (1000).
# Las cuentas puente se reconocen por nombre: data/referencia/cuentas-puente.json
CIERRE_MES=
CIERRE_VENTANA=
CIERRE_TOLERANCIA=
ESTADOS_MES=
ESTADOS_VENTANA=

# ---- Fase 3B: asientos de diario (sin comprobante electrónico) ----
# Permiso APARTE de PERMITIR_ESCRITURA (que es para facturas): con "si", un asiento APROBADO en la
# app se puede crear en Odoo. Por omisión se crea en BORRADOR; ASIENTOS_PUBLICAR=si además lo publica.
PERMITIR_ESCRITURA_ASIENTOS=
ASIENTOS_PUBLICAR=

# ---- Cambios masivos al plan de cuentas (objetivo 5) ----
# Con "si", un cambio APROBADO (renombrar, recodificar, crear u obsoletar una cuenta en varias
# compañías) se puede ejecutar en Odoo. Permiso aparte de los de facturas y asientos.
PERMITIR_ESCRITURA_CUENTAS=

# ---- Diferencial cambiario (fase 3B) ----
# Mes a revaluar (AAAA-MM; vacío = último mes cerrado) y monto mínimo por línea en colones (100).
CAMBIARIO_MES=
CAMBIARIO_MINIMO=

# ---- Gastos diferidos (fase 3B) ----
# Mes hasta el que se proponen cuotas (AAAA-MM; vacío = último mes cerrado).
DIFERIDOS_MES=

# ---- Depreciación de activos fijos (fase 3B) ----
# Mes hasta el que se propone depreciación (AAAA-MM; vacío = último mes cerrado).
DEPRECIACION_MES=

# ---- Cartera: antigüedad y recordatorios de cobro ----
# Fecha de corte (AAAA-MM-DD; vacío = hoy), días de vencida para recordar (1), monto mínimo vencido
# por cliente (1000) y días hacia adelante para «pagos que vencen pronto» (15).
CARTERA_CORTE=
CARTERA_DIAS_RECORDATORIO=
CARTERA_MINIMO=
CARTERA_PROXIMOS=

# --- Autonomía (fase 4): un tipo de propuesta × compañía pasa de NIVELES (todo a Aprobaciones) a
# AUTÓNOMO cuando una persona se lo da, y solo si es candidato: los dos últimos meses con decisiones
# son seguidos y sin correcciones, rechazos ni fallos. Mínimo de aprobaciones por mes (por omisión 1):
AUTONOMIA_MINIMO=
# Con «si» (y PERMITIR_ESCRITURA_ASIENTOS=si), lo aprobado por autonomía además se crea en Odoo. Si
# falla, ese tipo × compañía pierde la autonomía solo. Vacío: se aprueba solo, crear sigue siendo un botón.
AUTONOMIA_APLICAR=

# --- Hacienda (TRIBU-CR): el agente prepara las declaraciones del último mes cerrado. Mes a forzar (AAAA-MM):
HACIENDA_MES=
# Modelo del juez de IA (por omisión el del Director). Sin CLAUDE_API_KEY queda solo el juez de reglas.
HACIENDA_JUEZ_MODELO=
# A quién va el resumen del periodo (borrador en Correos; sin SMTP no sale):
HACIENDA_NOTIFICAR=
